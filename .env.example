# Frontend feature flags
# Default: keep Apple button iOS-only.
# Set to true in development if you want to preview the Apple button on non-iOS.
EXPO_PUBLIC_APPLE_SIGNIN_DEV_ALL_PLATFORMS=false
# Default: hide the Dev Login preset buttons. Set to true in a dev build for emulator
# testing against a backend started with DEV_LOGIN_ENABLED=1 (docs/dev-login.md).
# Release builds never show them.
EXPO_PUBLIC_DEV_LOGIN_ENABLED=false
# Optional custom-plan photo directory; defaults to /data/event-covers on Fly.
# Local default when launching from server/: server/.data/event-covers
# EVENT_COVERS_DIR=/absolute/path/to/local/event-covers
